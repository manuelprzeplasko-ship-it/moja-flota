rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WAŻNE: zamień WPISZ_UID_ADMINISTRATORA na UID konta administratora z Firebase Authentication.
    function admin() { return request.auth != null && request.auth.uid == 'WPISZ_UID_ADMINISTRATORA'; }
    function signedIn() { return request.auth != null; }
    match /vehicles/{vehicleId} {
      allow read, write: if admin();
      match /history/{entryId} { allow read, write: if admin(); }
    }
    match /publicVehicles/{vehicleId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if admin();
    }
    match /reports/{reportId} {
      allow read, update, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['vehicleId','driverName','odometer','note','status','createdAt'])
        && request.resource.data.keys().hasAll(['vehicleId','driverName','odometer','note','status','createdAt'])
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId.size() >= 10
        && request.resource.data.vehicleId.size() <= 40
        && exists(/databases/$(database)/documents/publicVehicles/$(request.resource.data.vehicleId))
        && get(/databases/$(database)/documents/publicVehicles/$(request.resource.data.vehicleId)).data.active == true
        && request.resource.data.driverName is string
        && request.resource.data.driverName.size() >= 1
        && request.resource.data.driverName.size() <= 80
        && request.resource.data.odometer is int
        && request.resource.data.odometer >= 0
        && request.resource.data.odometer <= 9999999
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }
  }
}
